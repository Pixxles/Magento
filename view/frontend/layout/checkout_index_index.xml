<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="checkout">
    <head>
    </head>

    <body>
        <referenceContainer name="after.body.start">
            <block class="P3\PaymentGateway\Block\JsConfig"
                   name="p3.kount.jsconfig"
                   template="P3_PaymentGateway::jsconfig.phtml"
                   before="-" />
        </referenceContainer>

        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="renders" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="p3-payments" xsi:type="array">
                                                                    <item name="component" xsi:type="string">
                                                                        P3_PaymentGateway/js/view/payment/show-payment
                                                                    </item>
                                                                    <item name="methods" xsi:type="array">
                                                                        <item name="P3_PaymentGateway" xsi:type="array">
                                                                            <item name="isBillingAddressRequired" xsi:type="boolean">
                                                                                true
                                                                            </item>
                                                                        </item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>

    </body>
</page>
